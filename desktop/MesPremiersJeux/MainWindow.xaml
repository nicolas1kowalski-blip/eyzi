<Window x:Class="MesPremiersJeux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gaze="clr-namespace:MesPremiersJeux.Gaze"
        Title="Eyzi" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#FFF3E9FF"
        FontFamily="./Fonts/#Fredoka One, Segoe UI, Segoe UI Emoji">
    <Grid x:Name="RootGrid">
        <DockPanel>
            <!-- Barre d'onglets (masquée pendant une activité pour gagner de la place) -->
            <Border x:Name="TopBar" DockPanel.Dock="Top" Padding="14,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFB388FF" Offset="0" />
                        <GradientStop Color="#FF8AD6FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Le porte-monnaie d'étoiles OUVRE LA BOUTIQUE (cliquable au regard). -->
                        <Button x:Name="StarsBtn" Style="{StaticResource TabButton}" MinWidth="110"
                                Margin="6,0" Click="Shop_Click">
                            <TextBlock x:Name="StarsText" Foreground="White" FontSize="18" FontWeight="Bold" />
                        </Button>
                        <TextBlock x:Name="GazeStatus" VerticalAlignment="Center"
                                   Foreground="White" FontSize="14" Margin="12,0" />
                        <Button x:Name="FullscreenBtn" Style="{StaticResource TabButton}"
                                Content="⛶" FontSize="26" MinWidth="60" Margin="6,0" Click="Fullscreen_Click" />
                        <Button x:Name="SettingsBtn" Style="{StaticResource TabButton}"
                                Content="⚙" FontSize="26" MinWidth="60" Margin="6,0"
                                gaze:GazeTargets.ParentOnly="True" Stylus.IsPressAndHoldEnabled="False"
                                ToolTip="Administration : maintenez appuyé 1 seconde (souris ou doigt)" />
                    </StackPanel>
                    <!-- Les onglets se RÉDUISENT si la place manque (Viewbox) :
                         « Musique » ne peut plus disparaître hors de l'écran. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="TabAccueil" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="accueil">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠  " FontSize="24" /><TextBlock Text="Accueil" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabStories" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="stories">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖  " FontSize="24" /><TextBlock Text="Histoires" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabGames" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="games">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮  " FontSize="24" /><TextBlock Text="Jeux" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabEdu" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="edu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎓  " FontSize="24" /><TextBlock Text="Éducatif" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabColoring" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="coloring">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨  " FontSize="24" /><TextBlock Text="Coloriage" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵  " FontSize="24" /><TextBlock Text="Musique" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabParcours" Style="{StaticResource TabButton}" Click="Parcours_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅  " FontSize="24" /><TextBlock Text="Parcours" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Viewbox>
                </DockPanel>
            </Border>

            <!-- Contenu de l'onglet actif -->
            <Grid x:Name="ContentHost" />
        </DockPanel>

        <!-- ⚙ ADMINISTRATION (accompagnant) : surcouche plein écran, lisible,
             rangée par pages. Ouverte par un appui LONG sur ⚙ (souris ou doigt),
             jamais par le regard ; le pilotage au regard est coupé tant qu'elle
             est ouverte (GazeGate). -->
        <Grid x:Name="AdminHost" Visibility="Collapsed" Background="#D90B1A33">
            <Grid.Resources>
                <Style x:Key="AdminNav" TargetType="Button">
                    <Setter Property="FontSize" Value="17" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#FF13306B" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="14,12" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE6EDFB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="AdminBtn" TargetType="Button">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Foreground" Value="#FF0B1A33" />
                    <Setter Property="Background" Value="#FFF3F6FC" />
                    <Setter Property="BorderBrush" Value="#FFCBD5EA" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="14,11" />
                    <Setter Property="Margin" Value="0,6,0,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE6EDFB" />
                                        <Setter Property="BorderBrush" Value="#FF1F5EFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="AdminPrimary" TargetType="Button" BasedOn="{StaticResource AdminBtn}">
                    <Setter Property="Background" Value="#FF1F5EFF" />
                    <Setter Property="BorderBrush" Value="#FF1F5EFF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#FFE1E7F3" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="Padding" Value="18,14,18,16" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                </Style>
                <Style x:Key="CardTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#FF13306B" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
                <Style x:Key="Label" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Foreground" Value="#FF0B1A33" />
                    <Setter Property="Margin" Value="0,10,0,4" />
                </Style>
                <Style x:Key="Hint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="Foreground" Value="#FF5B6B8A" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="LineHeight" Value="19" />
                    <Setter Property="Margin" Value="0,4,0,0" />
                </Style>
                <Style x:Key="Check" TargetType="CheckBox">
                    <Setter Property="FontSize" Value="15.5" />
                    <Setter Property="Foreground" Value="#FF0B1A33" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style x:Key="Field" TargetType="TextBox">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderBrush" Value="#FFCBD5EA" />
                    <Setter Property="Background" Value="#FFFBFCFE" />
                </Style>
                <Style x:Key="Pick" TargetType="ComboBox">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Padding" Value="10,8" />
                </Style>
                <Style x:Key="Page" TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="MaxWidth" Value="760" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>
            </Grid.Resources>

            <Border Background="#FFF4F6FB" CornerRadius="22" Margin="40,28" MaxWidth="1240"
                    BorderBrush="#FFFFC83D" BorderThickness="3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                    <!-- En-tête -->
                    <Border DockPanel.Dock="Top" Background="#FF13306B" CornerRadius="19,19,0,0" Padding="24,16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕  Fermer" FontSize="18" FontWeight="Bold" Padding="18,10"
                                    Background="#FFFFC83D" Foreground="#FF0B1A33" BorderThickness="0" Cursor="Hand"
                                    VerticalAlignment="Center" Click="AdminClose_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚙  Administration" FontSize="26" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="Réservée à l'accompagnant · le regard est en pause tant que ce panneau est ouvert · souris ou doigt seulement"
                                           FontSize="14" Foreground="#FFC9D6F2" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Pied : fenêtre -->
                    <Border DockPanel.Dock="Bottom" Background="#FFE9EEF8" CornerRadius="0,0,19,19" Padding="24,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="⛶  Plein écran" Style="{StaticResource AdminBtn}" Margin="8,0,0,0" Click="Fullscreen_Click" />
                                <Button Content="🗕  Réduire" Style="{StaticResource AdminBtn}" Margin="8,0,0,0" Click="Minimize_Click" />
                                <Button Content="⏻  Quitter Eyzi" Style="{StaticResource AdminBtn}" Margin="8,0,0,0" Foreground="#FFB00020" Click="Close_Click" />
                            </StackPanel>
                            <TextBlock x:Name="VersionText" FontSize="13" Foreground="#FF5B6B8A" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Menu de gauche -->
                    <Border DockPanel.Dock="Left" Width="250" Background="#FFE9EEF8" Padding="14,18">
                        <StackPanel>
                            <Button Tag="regard"  Content="👁   Regard"            Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                            <Button Tag="enfant"  Content="🧒   Enfant &amp; jeux"  Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                            <Button Tag="voix"    Content="🔊   Voix"              Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                            <Button Tag="contenu" Content="📁   Contenu"           Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                            <Button Tag="nuage"   Content="☁️   Licence &amp; nuage" Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                            <Button Tag="suivi"   Content="📊   Suivi"             Style="{StaticResource AdminNav}" Click="AdminNav_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Pages -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,10">
                        <Grid>

                        <!-- 👁 REGARD -->
                        <StackPanel x:Name="PageRegard" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Pilotage au regard" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="GazeModeCheck" Content="Piloter au regard (fixation = clic)" Style="{StaticResource Check}"
                                              Checked="GazeMode_Changed" Unchecked="GazeMode_Changed" />
                                    <CheckBox x:Name="AutoDwellCheck" Content="Ajuster tout seul le temps de fixation" Style="{StaticResource Check}"
                                              Checked="AutoDwell_Changed" Unchecked="AutoDwell_Changed" />
                                    <TextBlock Text="Source du regard (pilote)" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="DriverCombo" Style="{StaticResource Pick}" SelectionChanged="Driver_Changed">
                                        <ComboBoxItem Tag="auto" Content="🤖 Auto — direct si possible, sinon repli" />
                                        <ComboBoxItem Tag="direct" Content="👁 Regard direct (Tobii Experience)" />
                                        <ComboBoxItem Tag="stream" Content="⚡ Moteur Tobii direct (comme Grid 3)" />
                                        <ComboBoxItem Tag="streamA" Content="⚡ Moteur Tobii direct — version de l'application" />
                                        <ComboBoxItem Tag="pro" Content="🔬 Pro SDK (Tobii.Research)" />
                                        <ComboBoxItem Tag="curseur" Content="🖱 Curseur (TD Control — tout appareil)" />
                                    </ComboBox>
                                    <TextBlock x:Name="DriverStatus" Text="…" Style="{StaticResource Hint}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Le pilote change à chaud, sans redémarrer. « Curseur » marche avec toute commande oculaire qui déplace la souris." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Réglage fin" Style="{StaticResource CardTitle}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="DwellValue" DockPanel.Dock="Right" FontSize="15" FontWeight="Bold" Foreground="#FF13306B" VerticalAlignment="Center" />
                                        <TextBlock Text="Durée de fixation avant le clic" FontSize="15" Foreground="#FF0B1A33" />
                                    </DockPanel>
                                    <Slider x:Name="DwellSlider" Minimum="400" Maximum="2500" TickFrequency="100"
                                            IsSnapToTickEnabled="True" ValueChanged="DwellSlider_Changed" Margin="0,6,0,0" />
                                    <TextBlock Text="Lissage (stabilité du regard)" Style="{StaticResource Label}" />
                                    <Slider x:Name="SmoothSlider" Minimum="0" Maximum="100" ValueChanged="SmoothSlider_Changed" />
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="réactif" DockPanel.Dock="Left" Style="{StaticResource Hint}" Margin="0" />
                                        <TextBlock Text="très stable" DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="0" />
                                    </DockPanel>
                                    <TextBlock Text="Taille du cercle de fixation" Style="{StaticResource Label}" />
                                    <Slider x:Name="CircleSlider" Minimum="60" Maximum="170" ValueChanged="CircleSlider_Changed" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Calibrage et précision" Style="{StaticResource CardTitle}" />
                                    <Button Content="👁  Vérifier la position des yeux" Style="{StaticResource AdminBtn}" Click="EyeTrack_Click" />
                                    <Button Content="🎯  Calibrer la tablette (logiciel Tobii)" Style="{StaticResource AdminBtn}" Click="DeviceCalib_Click" />
                                    <Button Content="⭐  Réglage éclair (3 s, 1 étoile)" Style="{StaticResource AdminBtn}" Click="QuickFix_Click" />
                                    <UniformGrid Columns="2">
                                        <Button Content="🎯  Régler la précision (étoiles)…" Style="{StaticResource AdminBtn}" Margin="0,6,4,0" Click="Calibrate_Click" />
                                        <Button Content="↺  Annuler la correction" Style="{StaticResource AdminBtn}" Margin="4,6,0,0" Click="ClearBias_Click" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="« Calibrer la tablette » ouvre le calibrage Tobii installé (TD I-13, PCEye 5…). Activez le mode « Contrôle de l'ordinateur » pour que le regard déplace le curseur, puis cochez « Piloter au regard » ci-dessus." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 🧒 ENFANT & JEUX -->
                        <StackPanel x:Name="PageEnfant" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="L'enfant" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Prénom (activité « Mon prénom », messages)" Style="{StaticResource Label}" />
                                    <TextBox x:Name="ChildNameBox" Style="{StaticResource Field}" LostFocus="ChildName_Changed" />
                                    <TextBlock Text="Niveau des jeux" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="LevelCombo" Style="{StaticResource Pick}" SelectionChanged="Level_Changed">
                                        <ComboBoxItem Tag="auto" Content="🤖 Automatique — monte quand elle réussit" />
                                        <ComboBoxItem Tag="1" Content="🌱 Petite section — 2 choix, nombres jusqu'à 5" />
                                        <ComboBoxItem Tag="2" Content="🌿 Moyenne section — 3 choix, jusqu'à 7" />
                                        <ComboBoxItem Tag="3" Content="🌳 Grande section · CP — 4 choix, jusqu'à 10" />
                                    </ComboBox>
                                    <TextBlock x:Name="LevelStatus" Style="{StaticResource Hint}" />
                                    <TextBlock Text="Proposer une pause après (minutes de jeu)" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="SessionCombo" Style="{StaticResource Pick}" SelectionChanged="Session_Changed">
                                        <ComboBoxItem Tag="0" Content="Jamais" />
                                        <ComboBoxItem Tag="5" Content="5 minutes" />
                                        <ComboBoxItem Tag="10" Content="10 minutes" />
                                        <ComboBoxItem Tag="15" Content="15 minutes" />
                                        <ComboBoxItem Tag="20" Content="20 minutes" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Communication" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="CommBtnCheck" Content="💬 Tuile « Parler » toujours visible" Style="{StaticResource Check}"
                                              Checked="CommBtn_Changed" Unchecked="CommBtn_Changed" />
                                    <CheckBox x:Name="YesNoCheck" Content="✅ Tuiles « Oui / Non » toujours visibles" Style="{StaticResource Check}"
                                              Checked="YesNo_Changed" Unchecked="YesNo_Changed" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Les tuiles se déplacent à la souris ou au doigt : attrapez-les et glissez-les où vous voulez." />
                                    <Button Content="↺  Remettre les tuiles à leur place" Style="{StaticResource AdminBtn}" Click="ResetTiles_Click" />
                                    <Button Content="🙋  Je choisis (2 à 4 images, elle regarde celle qu'elle veut)" Style="{StaticResource AdminBtn}" Click="Choice_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 🔊 VOIX -->
                        <StackPanel x:Name="PageVoix" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Voix Windows (hors ligne)" Style="{StaticResource CardTitle}" />
                                    <ComboBox x:Name="VoiceCombo" Style="{StaticResource Pick}" SelectionChanged="Voice_Changed" />
                                    <TextBlock Text="Hauteur de la voix (aiguë = plus enfantine)" Style="{StaticResource Label}" />
                                    <Slider x:Name="PitchSlider" Minimum="-20" Maximum="60" ValueChanged="Pitch_Changed" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🌟 Voix naturelle (Azure, en ligne)" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Clé Azure Speech" Style="{StaticResource Label}" />
                                    <TextBox x:Name="AzureKeyBox" Style="{StaticResource Field}" LostFocus="Azure_Changed" />
                                    <TextBlock Text="Région" Style="{StaticResource Label}" />
                                    <TextBox x:Name="AzureRegionBox" Style="{StaticResource Field}" LostFocus="Azure_Changed" />
                                    <TextBlock Text="Voix" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="AzureVoiceCombo" Style="{StaticResource Pick}" SelectionChanged="Azure_Changed" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Sans clé : voix Windows. Avec clé : voix naturelle (Eloise = voix d'enfant). Repli automatique hors ligne." />
                                    <TextBlock x:Name="EnglishVoiceText" Style="{StaticResource Hint}" />
                                    <Button Content="🔈  Écouter un exemple" Style="{StaticResource AdminBtn}" Click="VoiceTest_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🎙 Vos voix" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0"
                                               Text="Enregistrez des « Bravo ! », un « Bonjour ! », les sons et les lettres avec votre voix : l'application les joue à la place de la voix de synthèse." />
                                    <Button Content="🎙  Enregistrer vos voix" Style="{StaticResource AdminPrimary}" Click="RecordVoices_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 📁 CONTENU -->
                        <StackPanel x:Name="PageContenu" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Outils d'édition" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="AdminCheck" Content="🔧 Afficher les outils d'édition dans l'application (regard en pause)" Style="{StaticResource Check}"
                                              Checked="GazeMode_Changed" Unchecked="GazeMode_Changed" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Une fois ce panneau fermé, les outils pour ajouter, modifier ou supprimer les livres, les coloriages et les photos apparaissent dans les activités. Décochez pour rendre la main à l'enfant." />
                                    <Button Content="👨‍👩‍👧  Gérer les photos de famille…" Style="{StaticResource AdminBtn}" Click="FamilyManager_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Le dossier de la famille" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="ContentDirInfo" Style="{StaticResource Hint}" Margin="0" />
                                    <Button Content="📂  Ouvrir le dossier du contenu" Style="{StaticResource AdminBtn}" Click="OpenContent_Click" />
                                    <UniformGrid Columns="2">
                                        <Button Content="📦  Exporter (sauvegarde)…" Style="{StaticResource AdminBtn}" Margin="0,6,4,0" Click="ExportContent_Click" />
                                        <Button Content="📥  Importer…" Style="{StaticResource AdminBtn}" Margin="4,6,0,0" Click="ImportContent_Click" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Photos, voix, livres, coloriages et images ajoutées vivent sur cette tablette. « Exporter » fait un seul fichier (sauvegarde, ou copie vers une autre tablette avec « Importer »)." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ☁️ LICENCE & NUAGE -->
                        <StackPanel x:Name="PageNuage" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🔑 Licence et mises à jour" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="LicenceText" Style="{StaticResource Hint}" Margin="0" FontSize="14.5" Foreground="#FF0B1A33" />
                                    <UniformGrid Columns="2">
                                        <Button Content="🔄  Vérifier les mises à jour" Style="{StaticResource AdminBtn}" Margin="0,6,4,0" Click="CheckUpdate_Click" />
                                        <Button Content="↩  Version précédente" Style="{StaticResource AdminBtn}" Margin="4,6,0,0" Click="Rollback_Click" />
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <Button Content="🔑  Changer la licence…" Style="{StaticResource AdminBtn}" Margin="0,6,4,0" Click="Licence_Click" />
                                        <Button Content="🚫  Libérer cette tablette" Style="{StaticResource AdminBtn}" Margin="4,6,0,0" Click="ReleaseTablet_Click" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Changement de poste : « Libérer » rend la place de cette tablette à la famille (la licence est limitée à un nombre de tablettes) et l'application redemandera une licence. L'éditeur peut aussi désactiver une tablette à distance." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="☁️ Le nuage de l'application" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0"
                                               Text="Le contenu de la famille est synchronisé entre vos tablettes, chiffré avec votre mot de passe famille (jamais lisible par personne d'autre). Automatique : récupéré au démarrage s'il y a du nouveau, envoyé à la fermeture si vous avez ajouté des choses." />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="CloudUpBtn" Content="☁️⬆  Envoyer maintenant" Style="{StaticResource AdminBtn}" Margin="0,8,4,0" Click="CloudUp_Click" />
                                        <Button x:Name="CloudDownBtn" Content="☁️⬇  Récupérer maintenant" Style="{StaticResource AdminBtn}" Margin="4,8,0,0" Click="CloudDown_Click" />
                                    </UniformGrid>
                                    <TextBlock x:Name="CloudStatusText" Style="{StaticResource Hint}" FontWeight="Bold" Foreground="#FF13306B" />
                                    <Expander Header="Réglages avancés du serveur" FontSize="14" Foreground="#FF5B6B8A" Margin="0,10,0,0">
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="URL du projet" Style="{StaticResource Label}" />
                                            <TextBox x:Name="SupabaseUrlBox" Style="{StaticResource Field}" LostFocus="Supabase_Changed" />
                                            <TextBlock Text="Clé" Style="{StaticResource Label}" />
                                            <TextBox x:Name="SupabaseKeyBox" Style="{StaticResource Field}" LostFocus="Supabase_Changed" />
                                            <TextBlock Style="{StaticResource Hint}" Text="À ne modifier que sur demande de l'éditeur." />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 📊 SUIVI -->
                        <StackPanel x:Name="PageSuivi" Style="{StaticResource Page}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Progrès de l'enfant" Style="{StaticResource CardTitle}" />
                                    <Button Content="📊  Bilan (semaine, niveaux, étoiles)" Style="{StaticResource AdminPrimary}" Click="Bilan_Click" />
                                    <Button Content="📊  Bilan de la session en cours…" Style="{StaticResource AdminBtn}" Click="Session_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Diagnostic" Style="{StaticResource CardTitle}" />
                                    <Button Content="🔎  Rapport du regard (comparer deux tablettes)" Style="{StaticResource AdminBtn}" Click="GazeReport_Click" />
                                    <Button Content="🧾  Ouvrir le journal" Style="{StaticResource AdminBtn}" Click="OpenLog_Click" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Le rapport du regard teste les deux moteurs Tobii l'un après l'autre (~15 s) et écrit un fichier dans le dossier de la famille, utile pour comparer deux tablettes ou l'envoyer à l'éditeur." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- La boutique de récompenses (surcouche plein écran, remplie en code) -->
        <Grid x:Name="ShopHost" Visibility="Collapsed" />

        <!-- 📒 Mon carnet (surcouche plein écran, remplie en code) -->
        <Grid x:Name="BookHost" Visibility="Collapsed" />

        <!-- 🙋 Je choisis (surcouche plein écran, remplie en code) -->
        <Grid x:Name="ChoiceHost" Visibility="Collapsed" />

        <!-- ⏱ La pause proposée (surcouche, remplie en code) -->
        <Grid x:Name="PauseHost" Visibility="Collapsed" />

        <!-- Cercle de progression du dwell (au-dessus de tout, non cliquable) -->
        <Canvas x:Name="GazeLayer" IsHitTestVisible="False">
            <!-- Point de regard toujours visible : l'enfant voit où il regarde. -->
            <Ellipse x:Name="GazeDot" Width="38" Height="38" Visibility="Collapsed"
                     Fill="#88FF3D7F" Stroke="White" StrokeThickness="3" />
            <Grid x:Name="GazeIndicator" Width="90" Height="90" Visibility="Collapsed">
                <Ellipse Width="74" Height="74" Stroke="#33512DA8" StrokeThickness="9"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="GazeProgress" Stroke="#FF7E3FF2" StrokeThickness="9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="56" Height="56" Fill="#33FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
